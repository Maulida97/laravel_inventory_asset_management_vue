APP_NAME="Inventory Asset Management"
APP_ENV=local
APP_KEY=
APP_TIMEZONE=Asia/Jakarta
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- DATABASE (MySQL Docker) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=inventory_asset_db
DB_USERNAME=inv_user
DB_PASSWORD=secret

# --- CACHE & SESSION (Redis Docker) ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- QUEUE & BROADCAST ---
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

# --- STORAGE & UPLOAD ---
FILESYSTEM_DISK=public

# --- MAIL (Mailpit Docker) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@assetmanagement.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- PAYMENT GATEWAY (Placeholder) ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# --- FRONTEND (Vite) ---
VITE_APP_NAME="${APP_NAME}"